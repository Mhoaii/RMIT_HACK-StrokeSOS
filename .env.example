# Simulation works with no Tide adapter and no API key.
# Complete the actual Tide realm setup; do not hand-construct an adapter.
# Local: export the public Tide adapter to data/tidecloak.json.
# Vercel: paste the full single-line public adapter JSON as CLIENT_ADAPTER.
CLIENT_ADAPTER=

# Optional real triage LLM. Server-side only. Simulation uses scripted responses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Required for live LLM DPoP replay protection on Vercel (optional locally).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LOCAL TIDECLOAK BOOTSTRAP ONLY. Never add these to NEXT_PUBLIC_* or commit them.
TIDECLOAK_URL=http://localhost:8080
REALM_NAME=zero-spyware-edge
CLIENT_NAME=zero-spyware-edge-client
CLIENT_APP_URL=http://localhost:3000
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
TIDE_LICENSE_EMAIL=
# Set yes only after the operator accepts https://tide.org/legal.
TIDE_TERMS_ACCEPTED=
